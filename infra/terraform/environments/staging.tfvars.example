environment                = "staging"
domain_name                = "staging.bankverse.example.com"
origin_domain_name         = "origin-staging.bankverse.example.com"
cloudfront_certificate_arn = "arn:aws:acm:us-east-1:111111111111:certificate/REPLACE"
alb_certificate_arn        = "arn:aws:acm:eu-west-3:111111111111:certificate/REPLACE"
api_image                  = "111111111111.dkr.ecr.eu-west-3.amazonaws.com/bankverse-staging/api@sha256:REPLACE"
web_image                  = "111111111111.dkr.ecr.eu-west-3.amazonaws.com/bankverse-staging/web@sha256:REPLACE"
worker_image               = "111111111111.dkr.ecr.eu-west-3.amazonaws.com/bankverse-staging/worker@sha256:REPLACE"
single_nat_gateway         = true
db_instance_class          = "db.t4g.medium"
db_multi_az                = false
api_desired_count          = 1
web_desired_count          = 1
monthly_budget_usd         = 300
budget_alert_emails        = ["finops@bankverse.example.com"]
alarm_email                = "oncall@bankverse.example.com"
