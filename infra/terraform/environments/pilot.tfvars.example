environment                = "pilot"
domain_name                = "pilot.bankverse.example.com"
origin_domain_name         = "origin-pilot.bankverse.example.com"
cloudfront_certificate_arn = "arn:aws:acm:us-east-1:111111111111:certificate/REPLACE"
alb_certificate_arn        = "arn:aws:acm:eu-west-3:111111111111:certificate/REPLACE"
api_image                  = "111111111111.dkr.ecr.eu-west-3.amazonaws.com/bankverse-pilot/api@sha256:REPLACE"
web_image                  = "111111111111.dkr.ecr.eu-west-3.amazonaws.com/bankverse-pilot/web@sha256:REPLACE"
worker_image               = "111111111111.dkr.ecr.eu-west-3.amazonaws.com/bankverse-pilot/worker@sha256:REPLACE"
single_nat_gateway         = false
db_instance_class          = "db.t4g.large"
db_multi_az                = true
db_backup_retention_days   = 14
api_desired_count          = 2
api_max_count              = 6
web_desired_count          = 2
monthly_budget_usd         = 800
budget_alert_emails        = ["finops@bankverse.example.com"]
alarm_email                = "oncall@bankverse.example.com"
